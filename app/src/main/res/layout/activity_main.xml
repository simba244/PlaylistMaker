<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_main_screen"
    android:orientation="vertical"
    tools:ignore="Overdraw">

    <RelativeLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:paddingStart="@dimen/padding_horizontal"
        android:paddingEnd="@dimen/padding_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/app_name"
            android:textColor="@color/white"
            android:textSize="@dimen/header_text_size" />

    </RelativeLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_search"
        style="@style/MainMenuButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/margin_top_large"
        android:layout_marginStart="@dimen/padding_horizontal"
        android:layout_marginEnd="@dimen/padding_horizontal"
        android:layout_marginBottom="@dimen/margin_standard"
        android:text="@string/menu_search"
        app:icon="@drawable/search" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_media"
        style="@style/MainMenuButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/padding_horizontal"
        android:layout_marginEnd="@dimen/padding_horizontal"
        android:layout_marginBottom="@dimen/margin_standard"
        android:text="@string/menu_media"
        app:icon="@drawable/media" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/button_settings"
        style="@style/MainMenuButton"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/padding_horizontal"
        android:layout_marginEnd="@dimen/padding_horizontal"
        android:layout_marginBottom="@dimen/padding_bottom_large"
        android:text="@string/menu_settings"
        app:icon="@drawable/settings" />
</LinearLayout>