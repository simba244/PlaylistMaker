<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:orientation="vertical">

    <!-- Хэдер -->
    <RelativeLayout
        android:id="@+id/panel_header"
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:paddingStart="@dimen/padding_horizontal"
        android:paddingEnd="@dimen/padding_horizontal"
        android:paddingTop="@dimen/padding_top_small">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="sans-serif-medium"
            android:text="@string/header_title"
            android:textColor="@color/white"
            android:textSize="@dimen/header_text_size" />

    </RelativeLayout>

    <!-- Контейнер карточек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/margin_top_large"
        android:orientation="vertical"
        android:paddingStart="@dimen/padding_horizontal"
        android:paddingEnd="@dimen/padding_horizontal"
        android:paddingBottom="@dimen/padding_bottom_large">

        <!-- Первая кнопка -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_search"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/margin_standard"
            android:text="@string/menu_search"
            android:textAllCaps="false"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@drawable/search"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/icon_padding"
            app:iconTint="@color/background_dark" />

        <!-- Вторая кнопка -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_media"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="@dimen/margin_standard"
            android:text="@string/menu_media"
            android:textAllCaps="false"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@drawable/inactive"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/icon_padding"
            app:iconTint="@color/background_dark" />

        <!-- Третья кнопка -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:text="@string/menu_settings"
            android:textAllCaps="false"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_button"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:backgroundTint="@color/white"
            app:cornerRadius="@dimen/button_corner_radius"
            app:icon="@drawable/settings"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/icon_padding"
            app:iconTint="@color/background_dark" />

    </LinearLayout>
</LinearLayout>