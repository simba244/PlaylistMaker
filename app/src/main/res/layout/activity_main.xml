<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_blue"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/margin_16"
    android:paddingTop="@dimen/margin_16">

    <!-- Заголовок приложения -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/white"
        android:textSize="@dimen/text_size_23"
        android:textStyle="bold" />

    <!-- Контейнер для кнопок с отступом сверху -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/margin_top_80"
        android:orientation="vertical">

        <!-- Первая кнопка: Поиск -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_search"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_220"
            android:text="@string/menu_search"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_23"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/inactive"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/background_dark" />

        <!-- Вторая кнопка: Медиатека -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_media"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_220"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/menu_media"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_23"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/search"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/background_dark" />

        <!-- Третья кнопка: Настройки -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/button_settings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/button_height_220"
            android:layout_marginTop="@dimen/margin_16"
            android:text="@string/menu_settings"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_23"
            android:textStyle="bold"
            android:textAllCaps="false"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp"
            app:icon="@drawable/settings"
            app:iconGravity="textStart"
            app:iconPadding="12dp"
            app:iconTint="@color/background_dark" />

    </LinearLayout>

</LinearLayout>