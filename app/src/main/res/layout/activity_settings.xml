<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_settings_screen"
    android:orientation="vertical">

    <!-- Шапка экрана -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/padding_horizontal">

        <ImageView
            android:id="@+id/button_back"
            android:layout_width="@dimen/icon_size"
            android:layout_height="@dimen/icon_size"
            android:layout_marginEnd="@dimen/margin_standard"
            android:src="@drawable/arrow_back"
            app:tint="@color/icon_settings"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_medium"
            android:text="@string/settings_title"
            android:textColor="@color/text_settings"
            android:textSize="@dimen/header_text_size" />
    </LinearLayout>

    <!-- Контейнер для списка настроек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_medium"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/padding_horizontal">

        <!-- Строка 1: Темная тема -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                style="@style/SettingsItemText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_dark_theme" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Строка 2: Поделиться приложением -->
        <TextView
            android:id="@+id/button_share"
            style="@style/SettingsItemText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height"
            android:gravity="center_vertical"
            android:text="@string/settings_share_app"
            android:drawableEnd="@drawable/share"
            android:drawableTint="@color/icon_settings"
            android:drawablePadding="@dimen/margin_standard" />

        <!-- Строка 3: Написать в поддержку -->
        <TextView
            android:id="@+id/button_support"
            style="@style/SettingsItemText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height"
            android:gravity="center_vertical"
            android:text="@string/settings_write_support"
            android:drawableEnd="@drawable/support"
            android:drawableTint="@color/icon_settings"
            android:drawablePadding="@dimen/margin_standard" />

        <!-- Строка 4: Пользовательское соглашение -->
        <TextView
            android:id="@+id/button_agreement"
            style="@style/SettingsItemText"
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height"
            android:gravity="center_vertical"
            android:text="@string/settings_user_agreement"
            android:drawableEnd="@drawable/arrow_forward"
            android:drawableTint="@color/icon_settings"
            android:drawablePadding="@dimen/margin_standard" />

    </LinearLayout>
</LinearLayout>