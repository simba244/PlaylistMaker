<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    android:visibility="visible"
    tools:visibility="visible">

    <!-- Шапка экрана -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/header_height_56"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/margin_16">

        <!-- Иконка "Назад" -->
        <ImageView
            android:id="@+id/button_back"
            android:layout_width="@dimen/icon_size_24"
            android:layout_height="@dimen/icon_size_24"
            android:layout_marginEnd="@dimen/margin_16"
            android:src="@drawable/arrow_back"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back_button" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_title"
            android:textColor="@color/background_dark"
            android:textSize="@dimen/text_size_23"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Контейнер для списка настроек -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_top_24"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/margin_16">

        <!-- Строка 1: Темная тема (Switch) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height_61"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_dark_theme"
                android:textColor="@color/background_dark"
                android:textSize="@dimen/text_size_16" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_theme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Строка 2: Поделиться приложением -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height_61"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_share_app"
                android:textColor="@color/background_dark"
                android:textSize="@dimen/text_size_16" />

            <ImageView
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:contentDescription="@string/settings_share_app"
                android:src="@drawable/share" />
        </LinearLayout>

        <!-- Строка 3: Написать в поддержку -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height_61"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_write_support"
                android:textColor="@color/background_dark"
                android:textSize="@dimen/text_size_16" />

            <ImageView
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:contentDescription="@string/settings_write_support"
                android:src="@drawable/support" />
        </LinearLayout>

        <!-- Строка 4: Пользовательское соглашение -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/list_item_height_61"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/settings_user_agreement"
                android:textColor="@color/background_dark"
                android:textSize="@dimen/text_size_16" />

            <ImageView
                android:layout_width="@dimen/icon_size_24"
                android:layout_height="@dimen/icon_size_24"
                android:contentDescription="@string/settings_user_agreement"
                android:src="@drawable/arrow_forward" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>