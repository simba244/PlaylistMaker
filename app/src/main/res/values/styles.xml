<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Кнопки главного экрана: без тени (UnelevatedButton), общий вид -->
    <style name="MainMenuButton" parent="Widget.MaterialComponents.Button.UnelevatedButton">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textFontWeight">500</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/background_dark</item>
        <item name="android:textSize">@dimen/text_size_button</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/white</item>
        <item name="cornerRadius">@dimen/button_corner_radius</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">@dimen/icon_padding</item>
        <item name="iconTint">@color/background_dark</item>
    </style>

    <style name="SettingsItemText">
        <item name="android:textSize">@dimen/text_size_body</item>
        <item name="android:textColor">@color/text_settings</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>
</resources>
